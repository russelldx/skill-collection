#!/usr/bin/env bash
# Read-only advisory sync diagnostics and blocking validation of Git index objects.
# Synchronization is a separate, explicit command; this hook never copies or stages.
set -euo pipefail
REPO_ROOT="$(git rev-parse --show-toplevel)"
if command -v python >/dev/null 2>&1; then
    exec python -B "$REPO_ROOT/sync-skills.py" --repo "$REPO_ROOT" hook
fi
exec python3 -B "$REPO_ROOT/sync-skills.py" --repo "$REPO_ROOT" hook
