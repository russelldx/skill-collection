#!/usr/bin/env bash
# pre-commit hook：提交前自动从本地 skill 目录同步到仓库
# 安装：cp .githooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
SKILLS_DIR="$REPO_ROOT/skills"

LOCAL_DIRS=()
for d in "$HOME/.qoder/skills" "$HOME/.agents/skills"; do
    [[ -d "$d" ]] && LOCAL_DIRS+=("$d")
done

[[ ${#LOCAL_DIRS[@]} -eq 0 ]] && exit 0

changed=0

for src_dir in "${LOCAL_DIRS[@]}"; do
    for skill_path in "$src_dir"/*/; do
        skill_name="$(basename "$skill_path")"
        [[ "$skill_name" == "tuomin" || "$skill_name" == "daibi" ]] && continue

        real_path="$(readlink -f "$skill_path" 2>/dev/null || echo "$skill_path")"
        [[ ! -d "$real_path" ]] && continue
        [[ ! -f "$real_path/SKILL.md" ]] && continue

        dest="$SKILLS_DIR/$skill_name"

        if [[ ! -d "$dest" ]]; then
            mkdir -p "$dest"
            cp -rL "$real_path/"* "$dest/"
            rm -f "$dest/_meta.json" "$dest/metadata.json" "$dest/.skill-metadata.yaml" 2>/dev/null || true
            git add "$dest"
            echo "[pre-commit] 新增 skill：$skill_name"
            changed=$((changed + 1))
        else
            if ! diff -rq "$real_path" "$dest" \
                --exclude="_meta.json" --exclude="metadata.json" --exclude=".skill-metadata.yaml" \
                >/dev/null 2>&1; then
                cp -rL "$real_path/"* "$dest/"
                rm -f "$dest/_meta.json" "$dest/metadata.json" "$dest/.skill-metadata.yaml" 2>/dev/null || true
                git add "$dest"
                echo "[pre-commit] 更新 skill：$skill_name"
                changed=$((changed + 1))
            fi
        fi
    done
done

[[ $changed -gt 0 ]] && echo "[pre-commit] 同步完成：$changed 个 skill 已更新并暂存"
exit 0
